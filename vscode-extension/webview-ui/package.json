{
  "name": "solvra-webview-ui",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "Solvra chat webview (v3). Built into ../media/v3 by `npm run build`.",
  "scripts": {
    "build": "tsc --noEmit -p . && vite build && node scripts/notices.mjs",
    "dev": "vite",
    "test": "vitest run",
    "shots": "node harness/shoot.mjs",
    "live": "node harness/live.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@vscode/codicons": "0.0.46-24",
    "motion": "14.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "streamdown": "2.7.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
